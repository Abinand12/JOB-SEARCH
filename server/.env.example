# Copy to server/.env for local development (`npm run dev`).
# On Railway, add the same names under the service's Variables tab.

# Supabase: Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database setup runs automatically on every Railway deploy when this is set.
# Supabase: Connect -> Connection string -> "Session pooler" (port 5432; Railway has no IPv6).
# Paste it as-is with [YOUR-PASSWORD] and put the password in DATABASE_PASSWORD,
# or put the URL-encoded password straight into the URL.
DATABASE_URL=postgresql://postgres.YOUR-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
DATABASE_PASSWORD=

# AI provider. Set ONE key; the provider is picked from whichever key is present,
# or force it with LLM_PROVIDER=gemini | groq | anthropic | openai_compatible.

# Free: Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Free: Groq key (https://console.groq.com/keys)
# GROQ_API_KEY=
# Paid, very cheap and the most accurate: Anthropic key (https://console.anthropic.com)
# ANTHROPIC_API_KEY=

# Optional overrides
# LLM_MODEL=gemini-flash-latest
# LLM_EFFORT=low                      # Anthropic only
# LLM_BASE_URL=https://openrouter.ai/api/v1   # with LLM_PROVIDER=openai_compatible and LLM_API_KEY
# LLM_API_KEY=
# LLM_PRICE_INPUT_PER_MTOK=0.10       # for the dashboard cost estimate
# LLM_PRICE_OUTPUT_PER_MTOK=0.50
# ANSWER_REQUESTS_PER_MINUTE=30
# Browser origins allowed to call the API, e.g. a Lovable-hosted dashboard.
# Default: https://*.lovable.app,https://*.lovableproject.com
# ALLOWED_ORIGINS=https://my-dashboard.lovable.app,https://jobs.example.com
